<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- Defaults build for Jellyfin 10.11. For 10.10 pass: -p:JellyfinVersion=10.10.7 -p:JellyfinTfm=net8.0 -->
    <JellyfinVersion Condition="'$(JellyfinVersion)' == ''">10.11.0</JellyfinVersion>
    <JellyfinTfm Condition="'$(JellyfinTfm)' == ''">net9.0</JellyfinTfm>
    <TargetFramework>$(JellyfinTfm)</TargetFramework>
    <RootNamespace>Jellyfin.Plugin.ArtworkStudio</RootNamespace>
    <AssemblyVersion>1.0.0.0</AssemblyVersion>
    <FileVersion>1.0.0.0</FileVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
    <CopyLocalLockFileAssemblies>false</CopyLocalLockFileAssemblies>
  </PropertyGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
    <PackageReference Include="Jellyfin.Controller" Version="$(JellyfinVersion)">
      <ExcludeAssets>runtime</ExcludeAssets>
    </PackageReference>
    <PackageReference Include="Jellyfin.Model" Version="$(JellyfinVersion)">
      <ExcludeAssets>runtime</ExcludeAssets>
    </PackageReference>
  </ItemGroup>

  <!-- Jellyfin 12 builds (.NET 10) get the JF12 features: search shortcuts etc. -->
  <PropertyGroup Condition="'$(JellyfinTfm)' == 'net10.0'">
    <DefineConstants>$(DefineConstants);JF12</DefineConstants>
  </PropertyGroup>

  <ItemGroup Condition="'$(JellyfinTfm)' == 'net10.0'">
    <PackageReference Include="Jellyfin.Data" Version="$(JellyfinVersion)">
      <ExcludeAssets>runtime</ExcludeAssets>
    </PackageReference>
    <PackageReference Include="Jellyfin.Database.Implementations" Version="$(JellyfinVersion)">
      <ExcludeAssets>runtime</ExcludeAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <None Remove="Web\artworkStudio.html" />
    <EmbeddedResource Include="Web\artworkStudio.html" />
    <None Remove="Web\libraryBackdrops.js" />
    <EmbeddedResource Include="Web\libraryBackdrops.js" />
    <None Remove="Web\presets.js" />
    <EmbeddedResource Include="Web\presets.js" />
    <None Remove="Web\enhancements.js" />
    <EmbeddedResource Include="Web\enhancements.js" />
    <EmbeddedResource Include="Web\tv\*" />
    <None Remove="Web\siteTheme.js" />
    <EmbeddedResource Include="Web\siteTheme.js" />
  </ItemGroup>

</Project>
